# Working directory: rendered manifests, plus k0rdent-<KCM>/ per cluster with
# its kcm checkout and pulled charts
.work/

# Downloaded CLI tools. Outside the workdir on purpose: removing a cluster
# throws its directory away, and re-downloading kubectl and helm is waste.
.bin/

# Kubeconfigs written by the scripts
kcfg_*

# Local environment (copy of scripts/set_envs_template.sh)
set_envs.sh

# Credentials -- never commit
gh_read_token.txt
*token*.txt

# Log dumps from collect_logs.sh
logs/
logs-*/

*.bak
