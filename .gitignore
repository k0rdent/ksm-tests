# Working directory: kcm checkout, pulled charts, rendered manifests
# (.work-<RUN_ID> for parallel runs)
.work/
.work-*/

# Downloaded CLI tools. Outside the workdir on purpose: `make clean` throws
# the environment away, and re-downloading kubectl and helm with it is waste.
.bin/

# Kubeconfigs written by the scripts
kcfg_*

# Local environment (copy of scripts/set_envs_template.sh)
set_envs.sh

# Credentials -- never commit
gh_read_token.txt
*token*.txt

# Log dumps from collect_logs.sh
logs/
logs-*/

*.bak
